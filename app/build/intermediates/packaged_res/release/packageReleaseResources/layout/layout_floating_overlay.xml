<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_overlay"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Download Speed Indicator -->
    <TextView
        android:id="@+id/tv_download_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/overlay_download_default"
        android:textColor="#00E5FF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false" />

    <!-- Separator -->
    <View
        android:layout_width="1dp"
        android:layout_height="12dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="#40FFFFFF" />

    <!-- Upload Speed Indicator -->
    <TextView
        android:id="@+id/tv_upload_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/overlay_upload_default"
        android:textColor="#10B981"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false" />

    <!-- Optional subtle close/minimize icon -->
    <ImageView
        android:id="@+id/btn_overlay_close"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:alpha="0.6"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="#94A3B8"
        android:contentDescription="Close overlay" />

</LinearLayout>
